{% extends 'base.html.twig' %}

{% block content %}
<div class="filters-bar">
    <a class="quick-filter {{ selectedType == '' ? 'is-active' : '' }}" href="?activity_type=">Wszystkie</a>
    {% for type in activityTypes %}
        <a class="quick-filter {{ selectedType == type.value ? 'is-active' : '' }}" href="?activity_type={{ type.value }}">{{ type.icon }} {{ type.label }}</a>
    {% endfor %}
</div>

<div class="results-meta">Pokazano {{ rows|length }} z {{ totalCount }} aktywności (najnowsze najpierw)</div>

<div class="table-wrap">
<table class="deals-table">
    <thead>
    <tr>
        <th>Data</th>
        <th>Rodzaj</th>
        <th>Opis</th>
        <th>Deal</th>
        <th>Osoba</th>
        <th>Status</th>
    </tr>
    </thead>
    <tbody>
    {% if rows is empty %}
        <tr><td colspan="6" class="empty-state">Brak aktywności dla wybranego filtra.</td></tr>
    {% endif %}
    {% for row in rows %}
        {% set activity = row.activity %}
        {% set deal = row.deal %}
        <tr>
            <td>{{ activity.timelineAt|datetime_pl }}</td>
            <td>{{ activity.type.icon }} {{ activity.type.label }}</td>
            <td class="cell-activity">
                „{{ activity.title }}”
                {% if activity.description is not null %}<div class="activity-desc">{{ activity.description }}</div>{% endif %}
            </td>
            <td class="cell-deal"><a class="deal-link" href="{{ path('deal_show', {id: deal.id}) }}">{{ deal.title }}</a></td>
            <td>{{ activity.performedBy.name }}</td>
            <td>
                {% if activity.isCompleted %}
                    <span class="flag flag-normal">Zakończone</span>
                {% else %}
                    <span class="flag flag-warning">Zaplanowane</span>
                {% endif %}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
</div>
{% endblock %}
