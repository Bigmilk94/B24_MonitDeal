{% extends 'base.html.twig' %}

{% block content %}
{% set statuses = {'': 'Wszystkie', 'open': 'Otwarte', 'overdue': 'Przeterminowane', 'completed': 'Zakończone'} %}
<div class="filters-bar">
    {% for key, label in statuses %}
        <a class="quick-filter {{ selectedStatus == key ? 'is-active' : '' }}" href="?status={{ key }}">{{ label }}</a>
    {% endfor %}
</div>

<div class="results-meta">Pokazano {{ rows|length }} zadań</div>

<div class="table-wrap">
<table class="deals-table">
    <thead>
    <tr>
        <th>Termin / wykonano</th>
        <th>Zadanie</th>
        <th>Deal</th>
        <th>Osoba</th>
        <th>Status</th>
    </tr>
    </thead>
    <tbody>
    {% if rows is empty %}
        <tr><td colspan="5" class="empty-state">Brak zadań dla wybranego filtra.</td></tr>
    {% endif %}
    {% for row in rows %}
        {% set task = row.task %}
        {% set deal = row.deal %}
        {% set is_overdue = task.isOverdue(now) %}
        <tr>
            <td>{{ task.isCompleted ? task.completedAt|datetime_pl : task.dueAt|datetime_pl }}</td>
            <td class="cell-activity">„{{ task.title }}”</td>
            <td class="cell-deal"><a class="deal-link" href="{{ path('deal_show', {id: deal.id}) }}">{{ deal.title }}</a></td>
            <td>{{ task.performedBy.name }}</td>
            <td>
                {% if task.isCompleted %}
                    <span class="flag flag-normal">✓ Zakończone</span>
                {% elseif is_overdue %}
                    <span class="flag flag-attention">! Przeterminowane</span>
                {% else %}
                    <span class="flag flag-warning">○ Otwarte</span>
                {% endif %}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
</div>
{% endblock %}
