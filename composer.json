{
    "name": "monitdeal/app",
    "description": "MonitDeal - operacyjny dashboard do monitorowania deali sprzedazowych i ich aktywnosci",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "symfony/framework-bundle": "^6.4",
        "symfony/yaml": "^6.4",
        "symfony/dotenv": "^6.4",
        "symfony/runtime": "^6.4",
        "symfony/console": "^6.4",
        "symfony/clock": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/routing": "^6.4",
        "symfony/event-dispatcher": "^6.4",
        "symfony/error-handler": "^6.4",
        "symfony/finder": "^6.4",
        "symfony/filesystem": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/config": "^6.4",
        "symfony/cache": "^6.4",
        "symfony/string": "^6.4",
        "symfony/var-dumper": "^6.4",
        "symfony/var-exporter": "^6.4",
        "symfony/http-client": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
