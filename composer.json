{
    "name": "monitdeal/app",
    "description": "MonitDeal - operacyjny dashboard do monitorowania deali sprzedazowych i ich aktywnosci",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/yaml": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/console": "^8.1",
        "symfony/clock": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
