###> app/bitrix24 ###
# Client id/secret from your Bitrix24 "local application" registration
# (Zasoby deweloperskie → Inne → Aplikacja lokalna). Leave empty to run the
# app in demo-only mode (no real Bitrix24 install possible until these are
# set) — put the real values in .env.local, never here.
BITRIX24_CLIENT_ID=
BITRIX24_CLIENT_SECRET=
